# Optional Google Maps SDK key for Android standalone/development builds.
# Restrict this key to the Android package name and signing certificate SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# Local Laravel API. Android emulator loopback is automatically mapped to 10.0.2.2.
# For a physical device, set the computer's LAN address (e.g. http://192.168.x.x:8000/api).
# With ngrok, use its current HTTPS forwarding URL, ending in /api.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
