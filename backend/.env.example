APP_NAME="Palesso API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8083
# Comma-separated production web origins. Leave unset locally to use FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Replace host/username/password with the Supabase Dashboard → Connect → Session pooler values.
# Keep DB_PASSWORD as a separate value (do not URL-encode it here).
# If using DB_URL instead, percent-encode reserved characters in the password, e.g. @ as %40.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production can set MEDIA_DISK=r2. Keep local disk for development without R2 keys.
MEDIA_DISK=local
QUEUE_CONNECTION=sync
MEDIA_VIDEO_ASYNC=false

# Cloudflare R2 S3 API. The endpoint is account-level; bucket is configured separately.
R2_ACCOUNT_ID=97cd36438ff51941c6a0f50a40a35f3b
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app-media
R2_ENDPOINT=https://97cd36438ff51941c6a0f50a40a35f3b.r2.cloudflarestorage.com
R2_REGION=auto
# Leave blank unless the bucket is intentionally public behind a real delivery domain.
R2_PUBLIC_BASE_URL=

MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_AUDIO_MAX_BYTES=20971520
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_REQUEST_MAX_BYTES=230686720
MEDIA_IMAGE_PROFILE=standard
MEDIA_IMAGE_QUALITY=85
MEDIA_IMAGE_MAX_WIDTH=2560
MEDIA_IMAGE_MAX_HEIGHT=2560
MEDIA_IMAGE_MAX_PIXELS=40000000
MEDIA_IMAGE_KEEP_ORIGINAL=false
MEDIA_IMAGE_THUMBNAIL=true
MEDIA_AUDIO_PROFILE=preserve_original
MEDIA_AUDIO_MAX_DURATION_SECONDS=3600
MEDIA_VIDEO_PROFILE=mobile_standard
MEDIA_VIDEO_ASYNC_THRESHOLD_BYTES=20971520
MEDIA_VIDEO_SYNC_THRESHOLD_BYTES=8388608
MEDIA_VIDEO_MAX_DURATION_SECONDS=180
MEDIA_VIDEO_MAX_WIDTH=1920
MEDIA_VIDEO_MAX_HEIGHT=1080
MEDIA_VIDEO_CRF=22
MEDIA_VIDEO_PRESET=veryfast
MEDIA_VIDEO_AUDIO_BITRATE=128k
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PROCESS_TIMEOUT_SECONDS=600
# Keep false locally if FFmpeg is unavailable; set true in production to reject unprobeable audio/video.
MEDIA_REQUIRE_PROBE=false

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# For Gmail, use a Google App Password (with 2-Step Verification enabled), not the account password.
# Put the App Password here without spaces; keep it only in this ignored backend/.env file.
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=NEW_GOOGLE_APP_PASSWORD
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME="Palesso"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
